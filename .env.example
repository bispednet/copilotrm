NODE_ENV=development
PORT_API_CORE=4010
DATABASE_URL=postgres://<user>:<password>@localhost:5432/copilotrm
REDIS_URL=redis://localhost:6379
DANEA_READONLY_DSN=odbc://danea-readonly
COPILOTRM_DATA_DIR=/path/to/copilotrm/data
BISPCRM_RUNTIME_DATA_DIR=/path/to/copilotrm/data
BISPCRM_ROOT_DIR=/path/to/copilotrm
BISPCRM_MIGRATIONS_DIR=/path/to/copilotrm/infra/migrations
# URL dell'api-core raggiungibile dai worker (per self-registration card, WordPress plugin, ecc.)
COPILOTRM_API_URL=http://localhost:4010
# Alias legacy compatibile per alcuni worker/gateway
API_CORE_URL=http://localhost:4010
BISPCRM_CHANNEL_GATEWAY_URL=http://localhost:4020
BISPCRM_CHANNEL_GATEWAY_TIMEOUT_MS=5000
BISPCRM_GATEWAY_INBOUND_TIMEOUT_MS=3000
BISPCRM_GATEWAY_CONTROL_TIMEOUT_MS=12000
BISPCRM_CHANNEL_DISPATCH_MODE=gateway-first
BISPCRM_REDIS_CONNECT_TIMEOUT_MS=3000
BISPCRM_ORCHESTRATOR_API_TIMEOUT_MS=5000
# Path opzionale ad un file .env esterno (es. ambiente Eliza) usato solo come fallback read-only
BISPCRM_ELIZA_ENV_PATH=
BISPCRM_AUTH_MODE=none
BISPCRM_PERSISTENCE_MODE=memory
BISPCRM_QUEUE_MODE=redis
BISPCRM_QUEUE_MEDIA_JOBS=true
BISPCRM_QUEUE_SEND_OUTBOX=true
SWARM_DEBUG_TELEGRAM=false

# ── LLM Routing ──────────────────────────────────────────────────────────────
# Provider primario: ollama | openai | anthropic | deepseek | tegem
LLM_PROVIDER=ollama
# Provider opzionale di fallback. Se usi Gemini/TeGem in produzione puoi lasciarlo vuoto
# per evitare risposte miste da provider diversi.
LLM_FALLBACK_PROVIDER=deepseek

# ── Ollama (locale / LAN) ────────────────────────────────────────────────────
OLLAMA_SERVER_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:27b
SMALL_OLLAMA_MODEL=gemma3:12b
MEDIUM_OLLAMA_MODEL=gemma3:12b
LARGE_OLLAMA_MODEL=gemma3:27b
USE_OLLAMA_EMBEDDING=
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# ── DeepSeek (cloud fallback economico) ──────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
SMALL_DEEPSEEK_MODEL=deepseek-chat
MEDIUM_DEEPSEEK_MODEL=deepseek-chat
LARGE_DEEPSEEK_MODEL=deepseek-reasoner

# ── OpenAI (opzionale) ───────────────────────────────────────────────────────
OPENAI_API_KEY=
SMALL_OPENAI_MODEL=gpt-4.1-mini
MEDIUM_OPENAI_MODEL=gpt-4.1-mini
LARGE_OPENAI_MODEL=gpt-4.1

# ── Anthropic (opzionale) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SMALL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_LARGE=claude-sonnet-4-6

# ── TeGem / Gemini via Playwright (opzionale) ────────────────────────────────
# Usa la sessione Chrome persistente già loggata su Gemini.
TEGEM_BASE_URL=https://gemini.google.com/app
PLAYWRIGHT_HEADLESS=false
# Lascia vuoto per usare il browser auto-rilevato:
# 1. ~/.local/bin/google-chrome-stable
# 2. ~/.local/share/tegem/browser/chrome-linux64/chrome
# 3. /usr/bin/google-chrome-stable
# 4. /usr/bin/google-chrome
PLAYWRIGHT_BROWSER_CHANNEL=
PLAYWRIGHT_EXECUTABLE_PATH=
PLAYWRIGHT_BASE_PROFILE_DIR=/home/funboy/copilotrm/.playwright/profiles
PLAYWRIGHT_PROFILE_NAMESPACE=chrome-stable
TEGEM_IMPORT_PROFILE_FROM=/home/funboy/TeGem/.playwright/profiles
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_CONVERSATION_TTL_MS=86400000
MAX_SESSION_TABS=20
STREAM_POLL_INTERVAL_MS=700
STREAM_STABLE_TICKS=4
STREAM_FIRST_CHUNK_TIMEOUT_MS=25000
STREAM_MAX_DURATION_MS=90000

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# ── Telegram Bot API ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ID_APPROVE_BOT=
TELEGRAM_CHANNEL_ID_APPROVE_POST=
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Email (SendGrid HTTP API) ─────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=CopilotRM

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_VERIFY_TOKEN=
# opzionale: se configurato, solo questi group IDs verranno serviti dal bot
WHATSAPP_ALLOWED_GROUP_IDS=

# ── Google Workspace (Sheets + Calendar) ──────────────────────────────────────
# Service account email
BISPCRM_GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key PEM; usare \n escaped se nel file .env
BISPCRM_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# opzionale: delegated user / domain-wide delegation
BISPCRM_GOOGLE_IMPERSONATED_USER=
# timezone usata per agenda/meeting rendering
BISPCRM_GOOGLE_TIMEZONE=Europe/Rome
# sync periodico nel runtime api-core
BISPCRM_GOOGLE_SYNC_INTERVAL_MS=300000
# durata meeting default se il testo non la specifica
BISPCRM_GOOGLE_MEETING_DURATION_MINUTES=45
# sendUpdates Google Calendar: all | externalOnly | none
BISPCRM_GOOGLE_MEETING_SEND_UPDATES=all
# calendar fallback usato per creare meeting
BISPCRM_GOOGLE_DEFAULT_CALENDAR_ID=
# array JSON di sheet sources: [{"spreadsheetId":"...","range":"Turni!A1:G","title":"Turni","kind":"shifts"}]
BISPCRM_GOOGLE_SHEETS_SOURCES_JSON=[]
# array JSON di calendar sources: [{"calendarId":"...","title":"Agenda condivisa","kind":"shared"}]
BISPCRM_GOOGLE_CALENDAR_SOURCES_JSON=[]

# ── WordPress (content pipeline) ─────────────────────────────────────────────
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ── EAN / Barcode product lookup ─────────────────────────────────────────────
# ean-search.org — registrazione gratuita su https://www.ean-search.org/
# Piano free: ~1000 lookup/mese; piano premium: illimitato
EAN_SEARCH_TOKEN=
# upcitemdb.com — https://www.upcitemdb.com/
# Free trial: 100 req/day senza chiave; con user_key fino a 10.000/day
UPCITEMDB_USER_KEY=
UPCITEMDB_URL=https://api.upcitemdb.com/prod/trial/lookup
# Timeout singola richiesta EAN in ms (default 8000)
EAN_LOOKUP_TIMEOUT_MS=8000

# ── Icecat product catalog (immagini HiRes + datasheet hardware/smartphone) ───
# Registrazione open: https://icecat.biz/en/activating-open-icecat.html
# Username del proprio account Icecat Open
ICECAT_USERNAME=
# full = open catalog + immagini; commercial = full catalog a pagamento
ICECAT_ACCESS=full

# ── GS1 Italy — GTIN/EAN registry ufficiale ──────────────────────────────────
# Necessario per lookup prodotti italiani sul registro GS1
# Info: https://www.gs1it.org/servizi/verifica-barcode/
GS1_API_KEY=
GS1_API_URL=https://api.gs1.org

# ── Price & market oracle ─────────────────────────────────────────────────────
# eBay Browse API — ricerca prezzi di mercato hardware/smartphone
# Developer account: https://developer.ebay.com/
EBAY_APP_ID=
EBAY_OAUTH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_IT
# Google Custom Search API — ricerca immagini e descrizioni prodotto
# Console: https://console.cloud.google.com/ — crea una CSE su https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ── RSS Feeds (pubblici) ─────────────────────────────────────────────────────
# Feed reali usati da worker-ingest all'avvio (formato JSON array RssSource)
RSS_FEEDS='[{"url":"https://www.hwupgrade.it/rss/news.xml","name":"HWUpgrade","category":"hardware"},{"url":"https://www.tomshw.it/feed","name":"TomsHW_IT","category":"hardware"},{"url":"https://www.hdblog.it/feed/","name":"HDBlog","category":"smartphone"},{"url":"https://www.smartworld.it/feed","name":"SmartWorld","category":"smartphone"},{"url":"https://www.mondomobileweb.it/feed/","name":"MondoMobileWeb","category":"mobile"},{"url":"https://www.key4biz.it/feed/","name":"Key4Biz","category":"tlc"},{"url":"https://www.rinnovabili.it/feed/","name":"Rinnovabili","category":"energy"},{"url":"https://www.canaleenergia.com/feed/","name":"CanaleEnergia","category":"energy"},{"url":"https://www.theverge.com/rss/index.xml","name":"TheVerge","category":"tech"},{"url":"https://arstechnica.com/feed/","name":"ArsTechnica","category":"tech"},{"url":"https://www.techradar.com/rss","name":"TechRadar","category":"tech"},{"url":"https://www.ilsole24ore.com/rss/tecnologia.xml","name":"Sole24Tech","category":"tech"},{"url":"https://www.zdnet.com/news/rss.xml","name":"ZDNet","category":"enterprise"},{"url":"https://www.gsmarena.com/rss-news-reviews.php3","name":"GSMArena","category":"smartphone"},{"url":"https://9to5google.com/feed/","name":"9to5Google","category":"android"},{"url":"https://9to5mac.com/feed/","name":"9to5Mac","category":"apple"}]'

# ── Fonti offerte pubbliche (catalogo URL) ───────────────────────────────────
# CSV URL pubblici usabili in ingest/monitoring; nessun segreto richiesto.
OFFER_SOURCES_ENERGY='https://www.ilportaleofferte.it/portaleOfferte/it/open-data.page,https://www.enelenergia.it/it/privati/elettricita-e-gas/,https://www.irenmercato.it/offerte/,https://www.enegan.it/offerte/,https://www.edisonenergia.it/offerte/'
OFFER_SOURCES_TELCO='https://confrontaofferte.agcom.it/,https://www.tim.it/offerte,https://www.fastweb.it/adsl-fibra-ottica/offerta-fisso-mobile/,https://privati.vodafone.it/casa/fibra,https://www.windtre.it/all-inclusive,https://www.iliad.it/'
BISPCRM_INGEST_PUBLIC_OFFERS=true
BISPCRM_PUBLIC_OFFERS_MAX=40
BISPCRM_INGEST_ROLE=admin
BISPCRM_INGEST_API_TIMEOUT_MS=8000

# ── Anagrafica azienda (per schede assistenza, PDF, preventivi) ───────────────
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_COUNTRY=Italy
COMPANY_PHONE=
COMPANY_PHONE2=
COMPANY_EMAIL=
COMPANY_PEC=
COMPANY_WEBSITE=
COMPANY_VAT=
COMPANY_CF=
COMPANY_REG=
COMPANY_BANK_IBAN=
COMPANY_CONSULTANT=

# ── Hardware Distributors ─────────────────────────────────────────────────────
# Amazon Product Advertising API 5.0 (nota: deprecazione 30 Apr 2026 → migrare a Creators API)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
# Ingram Micro API v6 (OAuth2 client_credentials)
INGRAM_CLIENT_ID=
INGRAM_CLIENT_SECRET=
INGRAM_CUSTOMER_NUMBER=
# Runner.it API
RUNNER_API_KEY=
# Nexths.it API
NEXTHS_API_KEY=
# Esprinet API
ESPRINET_CLIENT_ID=
ESPRINET_CLIENT_SECRET=
